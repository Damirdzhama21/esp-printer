# Токен платы: любая длинная случайная строка, её же вводите на странице настройки платы.
# Сгенерировать: openssl rand -hex 24
PRINTER_TOKEN=
# Токен для POST /api/print (если кладёте задания из своего кода)
ADMIN_TOKEN=
# Необязательно: Telegram-бот, которому шлёте PDF на печать (токен от @BotFather)
TG_BOT_TOKEN=
# Кому можно печатать: Telegram id через запятую. Пусто = никому (бот ответит вашим id, впишите его сюда)
TG_ALLOWED_IDS=
# Размер бумаги: a4, a5, letter
PAPER=a4
