CONFIG_IDF_TARGET="esp32s3"
# 4 МБ хватает и на N4, и на N16 (write_flash оставляет размер как есть)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# PSRAM не нужен: буфер 16 КБ во внутренней памяти, плата не обязана быть R8
CONFIG_SPIRAM=n
# консоль только UART0 (порт COM); нативный USB занят USB Host
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# у МФУ HP конфигурационный дескриптор длинный (принтер+сканер+IPP), 256 по умолчанию мало
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048
# сторож: задача печати сбрасывает его на каждом куске; зависла — перезагрузка
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# сертификаты Let's Encrypt и прочих — встроенный набор
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Android/iOS шлют длинные заголовки на проверку captive-portal
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
